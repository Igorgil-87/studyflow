# ── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...   # necessária pro texto de impacto dos carrosséis (Claude)

# Modelo LLM (ex: gpt-4o, gpt-4o-mini, claude-3-5-sonnet-20241022)
LLM_MODEL=gpt-4o-mini

# ── Whisper ────────────────────────────────────────────────
# tiny | base | small | medium | large  (large = mais preciso, mais lento)
WHISPER_MODEL=base

# ── Saída ─────────────────────────────────────────────────
OUTPUT_DIR=output/quizzes

# ── YouTube ────────────────────────────────────────────────
# Navegador para extrair cookies (chrome, firefox, safari, edge, brave)
# Deixe vazio para tentar sem cookies primeiro
COOKIES_BROWSER=chrome

# ── Auth (login da aplicação) ──────────────────────────────
APP_USER=admin
APP_PASS=TROQUE_ISSO_por_uma_senha_forte_de_verdade

# Chave secreta para sessões Flask — mude em produção!
SECRET_KEY=GERE_UMA_CHAVE_NOVA_rode:_python3_-c_"import secrets;print(secrets.token_hex(32))"

# ── Twitter / X (opcional) ────────────────────────────────
# Obtenha em: https://developer.twitter.com/en/portal/dashboard
# Deixe vazio para desabilitar a fonte Twitter no Módulo Youtuber
TWITTER_BEARER_TOKEN=

# ── Escala / Fila (infra) ─────────────────────────────────
# RUN_MODE=inline  → dev: tudo em processo, sem Redis (padrão).
# RUN_MODE=redis   → prod: fila externa (RQ) + SSE via Redis Pub/Sub + workers.
RUN_MODE=inline

# Obrigatório quando RUN_MODE=redis. Ex.: redis://localhost:6379/0
REDIS_URL=

# Nome da fila RQ e tempos de vida/timeout (opcionais)
QUEUE_NAME=studyflow
JOB_TTL_SECONDS=3600
JOB_TIMEOUT_SECONDS=1800
LLM_TIMEOUT=180

# ── Observabilidade & Evals (obs/) ────────────────────────
# Caminho do store SQLite de traces/feedback/evals
OBS_DB=output/observability.db
# Tracing de chamadas de LLM (1 liga, 0 desliga)
OBS_TRACING=1
# Avaliação automática do quiz via LLM-as-Judge (custa 1 chamada por job)
EVAL_ENABLED=0
# Modelo do juiz (default = LLM_MODEL)
EVAL_JUDGE_MODEL=gpt-4o-mini

# ── Cache semântico (cache/) ──────────────────────────────
# Liga o cache de respostas de LLM (1 liga, 0 desliga = padrão)
CACHE_ENABLED=0
# Camada semântica por embedding (1) ou só cache exato por hash (0)
CACHE_SEMANTIC=1
# Modelo de embedding e limiar de similaridade (cosseno) para acerto semântico
CACHE_EMBED_MODEL=text-embedding-3-small
CACHE_SIM_THRESHOLD=0.95

# ── Drift de IA (obs/drift.py) ────────────────────────────
DRIFT_RECENT_HOURS=24
DRIFT_BASELINE_HOURS=168
DRIFT_LATENCY_PCT=0.30
DRIFT_ERROR_ABS=0.05
DRIFT_COST_PCT=0.50
DRIFT_JUDGE_DROP_ABS=0.10
DRIFT_HALLUC_ABS=0.10
DRIFT_MIN_SAMPLES=5

# ── Agendador de drift (scheduler.py) ─────────────────────
# Intervalo entre verificações automáticas (segundos)
DRIFT_INTERVAL_SECONDS=3600
# Cooldown anti-spam entre notificações do mesmo alerta (minutos)
DRIFT_NOTIFY_COOLDOWN_MIN=60
# Webhook para alertas (Slack/Discord/endpoint próprio). Vazio = só loga.
DRIFT_WEBHOOK_URL=

# ── Publicação no YouTube (publish/) ──────────────────────
# Caminho do client_secret.json baixado do Google Cloud Console
YOUTUBE_CLIENT_SECRETS=client_secret.json
# Onde guardar o token OAuth após autorizar (NÃO versionar)
YOUTUBE_TOKEN_FILE=youtube_token.json
# Privacidade do upload: private | unlisted | public
# (public exige app verificado pelo Google; default seguro = private)
YOUTUBE_PRIVACY=private
# Categoria do vídeo (22=People & Blogs, 27=Education)
YOUTUBE_CATEGORY_ID=22

# ── Detecção de pouca fala (vídeo música/instrumental) ────
# Abaixo deste nº de palavras/min, avisa que o corte pode ficar fraco
LOW_SPEECH_WPM=25

# ── RAG / Base vetorial (rag/ · Postgres + pgvector) ──────
RAG_ENABLED=0
# hostname do Postgres muda dependendo de como você roda o StudyFlow:
#   - via docker-compose (web/worker DENTRO de containers): use "postgres"
#     (nome do serviço no docker-compose.full.yml — "localhost" aqui de
#     dentro do container aponta pro próprio container, não pro Postgres,
#     e dá "Connection refused")
#   - rodando nativo no Mac (fora do Docker): use "localhost"
DATABASE_URL=postgresql://studyflow:TROQUE_ISSO_senha_forte@postgres:5432/studyflow
RAG_EMBED_DIM=1536
RAG_TOP_K=5
RAG_CHUNK_CHARS=600
RAG_CHUNK_SECONDS=60
# Qual LLM responde as perguntas do RAG (/rag) e escreve o texto dos
# carrosséis usando o contexto indexado: "anthropic" (padrão, usa
# ANTHROPIC_API_KEY + CLAUDE_MODEL) ou "openai" (usa OPENAI_API_KEY +
# LLM_MODEL). Os EMBEDDINGS continuam sempre via OpenAI — a Anthropic não
# tem API própria de embeddings, então isso não muda com essa opção.
RAG_LLM_PROVIDER=anthropic

# ── Cache das tendências (economiza chamadas de IA) ───────
TRENDS_CACHE_TTL=3600          # 1 hora
TTL_CACHE_DB=output/ttl_cache.db

# ── Login & usuários ──────────────────────────────────────
USERS_DB=output/users.db
# OAuth social (opcional — só liga o que você preencher). Veja OAUTH_LOGIN_SETUP.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# ── MFA por e-mail (opcional) ─────────────────────────────
MFA_ENABLED=0                 # 1 para exigir código por e-mail no login
MFA_CODE_TTL=600              # validade do código (segundos)
# SMTP para enviar o código (sem isto, modo DEV imprime no console):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Fontes extras das tendências (opcionais) ──────────────
PERPLEXITY_API_KEY=           # IA + busca + citações (api.perplexity.ai)
PERPLEXITY_MODEL=sonar        # modelo mais barato
NEWS_PROVIDER=gnews           # gnews | newsdata
NEWS_API_KEY=                 # chave da API de notícias
NEWS_LANG=pt
NEWS_COUNTRY=br

# ── X / Twitter (opcional, via API de terceiro barata) ────
X_ENABLED=1
X_PROVIDER=twitterapi          # twitterapi | getxapi
X_API_KEY=                     # twitterapi.io (US$1 grátis) ou getxapi.com
X_LANG=pt
X_MIN_FAVES=50                 # engajamento mínimo (50 traz mais; 300+ só o que muito bomba)
X_MAX_RESULTS=10

# ── Orquestração multi-IA dos cortes (opcional) ──────────
# Passe de reforço quando a 1ª IA traz menos cortes que o pedido.
# Use um modelo Claude p/ variar a "cabeça" (precisa ANTHROPIC_API_KEY):
CLIP_FILL_MODEL=claude-haiku-4-5-20251001

# ── Ações B3 na faixa de mercado (opcional, brapi.dev) ────
BRAPI_TOKEN=                   # opcional (reserva); yfinance é o primário e nao precisa de chave

# ── Widget de clima (OpenWeather, endpoint clássico grátis SEM cartão) ────
OPENWEATHER_API_KEY=           # grátis em openweathermap.org (ativa em ~2h)
WEATHER_CITY=São Paulo,BR      # cidade do widget de clima

# ── Widget GitHub em alta (Search API, sem chave; token opcional eleva limite) ──
GITHUB_TOKEN=                  # opcional: github.com/settings/tokens (sem escopo)
GITHUB_TTL=1800                # cache em segundos (30 min) p/ não bater no limite

# ── Widget Hacker News Top (API oficial Firebase, SEM chave) ──
HN_TTL=900                     # cache em segundos (15 min)

# ── Widget NASA Foto do Dia (APOD) — DEMO_KEY funciona; chave grátis p/ mais ──
NASA_API_KEY=                  # grátis em api.nasa.gov (chega por email); vazio usa DEMO_KEY
NASA_TTL=21600                 # cache em segundos (6h) — muda 1x/dia

# ── Porta do app (default 5001 — evita o AirPlay do macOS na porta 5000) ──
APP_PORT=5001

# ── Módulo Criador · Imagens (opção nuvem) ──────────────────────────
# Usa a mesma OPENAI_API_KEY de cima. Ajuste só se quiser trocar o
# modelo padrão (gpt-image-1-mini = mais barato) ou a qualidade.
OPENAI_IMAGE_MODEL=gpt-image-1-mini
OPENAI_IMAGE_QUALITY=low

# ── Crawl4AI (Curso: indexar URL no RAG · Trends: contexto extra) ────
# Roda como serviço Docker SEPARADO (docker-compose.full.yml, serviço
# "crawl4ai") — NÃO é um pacote Python instalado aqui, de propósito (ver
# comentário em tools/crawler_client.py). Se rodar via docker-compose.full.yml,
# não precisa mexer nisso — já vem certo. Só troque se expuser o serviço
# em outro host/porta.
CRAWL4AI_URL=http://crawl4ai:11235

# ── Módulo Criador · Texto de impacto do carrossel (Claude) ─────────
# Usa ANTHROPIC_API_KEY (topo do arquivo, LLM). Gera automaticamente o
# texto de cada slide e aplica com tipografia real por cima do fundo —
# evita o problema de texto deformado quando a própria IA de imagem
# tenta "escrever" letras.
CLAUDE_COPY_MODEL=claude-haiku-4-5-20251001

# ── Publicar no Instagram (carrossel do Módulo Criador) ─────────────
# Cloudinary: conta grátis em cloudinary.com — armazena as imagens
# publicamente (o Instagram exige URL pública, não aceita bytes direto).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Instagram Graph API — veja o guia completo em COMO_RODAR_CRIADOR.md
# (precisa de conta Business/Creator + Página do Facebook + App na Meta)
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=

# ══════════════════════════════════════════════════════════
# ── Só pra produção na nuvem (docker-compose.prod.yml) ──────
# ══════════════════════════════════════════════════════════

# Senha do Postgres — TEM que bater com a senha usada em DATABASE_URL
# acima. Gere uma senha forte de verdade, não deixe a padrão.
POSTGRES_PASSWORD=TROQUE_ISSO_mesma_senha_do_DATABASE_URL_acima

# Login do n8n (antes rodava sem senha nenhuma — na nuvem, com o painel
# exposto na internet, isso vira porta aberta pra qualquer um)
N8N_USER=admin
N8N_PASSWORD=TROQUE_ISSO_por_outra_senha_forte

# MoneyPrinter (Módulo Criador) — deixe em branco se não for configurar
# isso na nuvem ainda (o resto do app funciona normal sem ele)
MPT_API_URL=

# Fooocus (geração de imagem) — precisa de GPU, a maioria dos
# servidores baratos não tem. Deixe como está (desligado) a menos que
# você tenha um serviço de geração de imagem compatível rodando em
# algum lugar com GPU.
FOOOCUS_API_URL=http://disabled:8888
